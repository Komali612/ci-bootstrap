# cicd-bootstrap configuration.
# Copy this file to ".env" (same folder) and fill in YOUR OWN values.
# The real .env is gitignored, so your keys never leave your machine.

# From  console.anthropic.com  →  API Keys   (looks like  sk-ant-...)
ANTHROPIC_API_KEY=

# From  sonarcloud.io  →  My Account  →  Security  →  Generate Token
SONAR_TOKEN=

# Your SonarCloud organization key   (sonarcloud.io  →  your organization)
SONAR_ORG=

# GitHub access is handled by signing in with:  gh auth login
# (so you normally do NOT need to put a GitHub token here).

# --- Harness CD --------------------------------------------------------------
# Only needed if you deploy via Harness instead of GitHub Actions.
# All values come from  app.harness.io  after you sign up (free tier).
# The two tokens are SECRETS — they live here in .env only, never in chat.

# Account ID:  Account Settings → Account Details / Overview
HARNESS_ACCOUNT_ID=

# API key (SECRET):  your profile (top-right) → My API Keys → +API Key → +Token
HARNESS_API_KEY=

# Delegate token (SECRET):  Account Settings → Account Resources → Delegates → Tokens
HARNESS_DELEGATE_TOKEN=

# Your Harness URL (copy the exact one Harness shows you; SaaS default below)
HARNESS_MANAGER_HOST=https://app.harness.io
