# ci-bootstrap configuration.
# Copy this file to ".env" (same folder) and fill in YOUR OWN values.
# The real .env is gitignored, so your keys never leave your machine.

# From  console.anthropic.com  →  API Keys   (looks like  sk-ant-...)
ANTHROPIC_API_KEY=

# From  sonarcloud.io  →  My Account  →  Security  →  Generate Token
SONAR_TOKEN=

# Your SonarCloud organization key   (sonarcloud.io  →  your organization)
SONAR_ORG=

# GitHub access is handled by signing in with:  gh auth login
# (so you normally do NOT need to put a GitHub token here).
